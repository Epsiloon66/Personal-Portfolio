---
import Background from '../components/Background.astro';
interface Props {
  title?: string;
}
const { title = 'GUILLERMO JIMÉNEZ — PORTFOLIO' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfolio personal de Guillermo Jiménez — Desarrollador web" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <nav class="nav-bar">
      <span class="nav-logo">GJ</span>
      <ul class="nav-links">
        <li><a href="#hero">INICIO</a></li>
        <li><a href="#about">PERSONAJE</a></li>
        <li><a href="#skills">STATS</a></li>
        <li><a href="#projects">MISIONES</a></li>
        <li><a href="#contact">CONTACTO</a></li>
      </ul>
    </nav>

    <Background />
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .nav-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 2rem;
    background: rgba(10, 10, 10, 0.92);
    border-bottom: 2px solid var(--accent);
    font-family: var(--font-pixel);
    font-size: 0.55rem;
  }

  .nav-logo {
    color: var(--accent);
    font-size: 0.7rem;
    letter-spacing: 2px;
  }

  .nav-links {
    list-style: none;
    display: flex;
    gap: 1.5rem;
  }

  .nav-links a {
    color: var(--text);
    text-decoration: none;
    transition: color 0.1s;
    letter-spacing: 1px;
  }

  .nav-links a:hover {
    color: var(--accent);
    text-shadow: 0 0 8px var(--accent);
  }
</style>
