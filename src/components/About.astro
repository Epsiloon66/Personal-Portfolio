---
const characters = [
  {
    id: 1,
    photo: '/avatar.jpg',
    fallback: 'GJ',
    name: 'GUILLERMO JIMÉNEZ',
    clase: 'DEV FULLSTACK',
    claseColor: 'var(--accent3)',
    stats: [
      { label: 'NOMBRE',  value: 'Guillermo J. M.' },
      { label: 'CLASE',   value: 'Desarrollador Web' },
      { label: 'NIVEL',   value: 'EN PROGRESO', blink: true },
      { label: 'MISIÓN',  value: 'Crear experiencias web únicas' },
    ],
    bio: 'Desarrollador apasionado por la web y las nuevas tecnologías. Me gusta construir proyectos con personalidad propia, desde la arquitectura hasta el último píxel.',
    borderColor: 'var(--accent)',
    glowColor: 'rgba(0,255,65,0.3)',
  },
  {
    id: 2,
    photo: '/avatar-focused.jpg',
    fallback: '⚡',
    name: 'GUILLERMO "FOCUS"',
    clase: 'CODE MACHINE',
    claseColor: '#00b4d8',
    stats: [
      { label: 'NOMBRE',  value: 'Guillermo J. M.' },
      { label: 'CLASE',   value: 'Code Machine' },
      { label: 'MODO',    value: 'CONCENTRACIÓN MAX', blink: true },
      { label: 'MISIÓN',  value: 'Optimizar. Refactorizar. Dominar.' },
    ],
    bio: 'Cuando hay que entregar, desaparece todo lo demás. Café, código y silencio absoluto. No me hables hasta que cierre el último PR.',
    borderColor: '#00b4d8',
    glowColor: 'rgba(0,180,216,0.3)',
  },
];
---

<section id="about" class="about">
  <div class="about-inner pixel-box">
    <div class="section-header">
      <span class="section-tag">// SELECT CHARACTER</span>
      <span class="char-counter" id="char-counter">1 / 2</span>
    </div>

    <div class="char-select">
      <!-- Portrait + nav -->
      <div class="portrait-col">
        <button class="nav-arrow" id="prev-btn" aria-label="Anterior">◄</button>

        <div class="char-card" id="char-card">
          {characters.map((c, i) => (
            <div class={`char-slot ${i === 0 ? 'active' : ''}`} data-index={i}>
              <div class="char-portrait">
                <img
                  src={c.photo}
                  alt={c.name}
                  class="portrait-photo"
                  onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                />
                <div class="portrait-inner portrait-fallback">{c.fallback}</div>
              </div>
              <div class="char-name" >{c.name}</div>
              <div class="char-class" style={`color:${c.claseColor}`}>▶ {c.clase}</div>
            </div>
          ))}
        </div>

        <button class="nav-arrow" id="next-btn" aria-label="Siguiente">►</button>
      </div>

      <!-- Stats panel -->
      <div class="char-info" id="char-info">
        {characters.map((c, i) => (
          <div class={`info-slot ${i === 0 ? 'active' : ''}`} data-index={i}>
            {c.stats.map(s => (
              <div class="info-row">
                <span class="label">{s.label}</span>
                <span class="value">
                  {s.value}{s.blink ? <span class="blink"> ▮</span> : ''}
                </span>
              </div>
            ))}
            <div class="bio-box">
              <p class="bio-text">{c.bio}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="select-prompt blink">◄ ► PARA CAMBIAR PERSONAJE</div>
  </div>
</section>

<script>
  const chars = document.querySelectorAll<HTMLElement>('.char-slot');
  const infos = document.querySelectorAll<HTMLElement>('.info-slot');
  const card  = document.getElementById('char-card')!;
  const counter = document.getElementById('char-counter')!;
  const COLORS = ['var(--accent)', '#00b4d8', 'var(--accent2)'];
  const GLOWS  = ['rgba(0,255,65,0.3)', 'rgba(0,180,216,0.3)', 'rgba(255,0,110,0.3)'];
  let current = 0;

  function go(dir: number) {
    chars[current].classList.remove('active');
    infos[current].classList.remove('active');
    current = (current + dir + chars.length) % chars.length;
    chars[current].classList.add('active');
    infos[current].classList.add('active');
    card.style.borderColor = COLORS[current];
    card.style.boxShadow = `0 0 16px ${GLOWS[current]}`;
    counter.textContent = `${current + 1} / ${chars.length}`;
  }

  document.getElementById('prev-btn')!.addEventListener('click', () => go(-1));
  document.getElementById('next-btn')!.addEventListener('click', () => go(1));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft')  go(-1);
    if (e.key === 'ArrowRight') go(1);
  });
</script>

<style>
  .about {
    background: var(--darker);
    padding-top: 4rem;
  }

  .about-inner {
    max-width: 860px;
    width: 100%;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .section-tag {
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    color: var(--accent2);
    letter-spacing: 2px;
  }

  .char-counter {
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    color: rgba(0,255,65,0.5);
    letter-spacing: 2px;
  }

  /* Layout */
  .char-select {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2rem;
    align-items: start;
  }

  .portrait-col {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Nav arrows */
  .nav-arrow {
    background: none;
    border: 2px solid rgba(0,255,65,0.3);
    color: var(--accent);
    font-family: var(--font-pixel);
    font-size: 0.6rem;
    padding: 0.5rem 0.4rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.1s, color 0.1s, transform 0.08s;
    flex-shrink: 0;
  }

  .nav-arrow:hover {
    border-color: var(--accent);
    background: rgba(0,255,65,0.08);
    transform: scale(1.1);
  }

  .nav-arrow:active {
    transform: scale(0.95);
  }

  /* Card */
  .char-card {
    border: 2px solid var(--accent);
    padding: 1rem;
    text-align: center;
    box-shadow: 0 0 12px rgba(0,255,65,0.3);
    position: relative;
    flex: 1;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  /* Slots */
  .char-slot { display: none; }
  .char-slot.active { display: block; }
  .info-slot { display: none; }
  .info-slot.active { display: flex; flex-direction: column; gap: 0.75rem; }

  /* Portrait */
  .char-portrait {
    width: 120px;
    height: 150px;
    border: 2px solid currentColor;
    margin: 0 auto 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--dark);
    overflow: hidden;
    position: relative;
  }

  .portrait-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: none;
  }

  .portrait-fallback {
    display: none;
    font-family: var(--font-pixel);
    font-size: 1.8rem;
    color: var(--accent);
  }

  .char-name {
    font-family: var(--font-pixel);
    font-size: 0.45rem;
    color: var(--accent);
    margin-top: 0.75rem;
    margin-bottom: 0.6rem;
    letter-spacing: 2px;
    line-height: 1.8;
  }

  .char-class {
    font-family: var(--font-vt);
    font-size: 1.1rem;
    letter-spacing: 3px;
    padding-bottom: 0.25rem;
  }

  /* Info panel */
  .info-row {
    display: flex;
    gap: 1rem;
    font-size: 0.5rem;
    border-bottom: 1px solid rgba(0,255,65,0.1);
    padding-bottom: 0.5rem;
    font-family: var(--font-pixel);
  }

  .label {
    color: var(--accent3);
    min-width: 80px;
    flex-shrink: 0;
  }

  .value { color: var(--text); }

  .bio-box {
    border: 1px solid rgba(0,255,65,0.2);
    padding: 1rem;
    margin-top: 0.25rem;
    background: rgba(0,255,65,0.03);
  }

  .bio-text {
    font-family: var(--font-vt);
    font-size: 1.1rem;
    color: var(--text);
    line-height: 1.6;
  }

  .select-prompt {
    font-family: var(--font-pixel);
    font-size: 0.45rem;
    color: rgba(0,255,65,0.5);
    text-align: center;
    margin-top: 2rem;
    letter-spacing: 2px;
  }

  @media (max-width: 600px) {
    .char-select { grid-template-columns: 1fr; }
    .portrait-col { justify-content: center; }
  }
</style>
