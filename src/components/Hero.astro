---
---

<section id="hero" class="hero">
  <div class="hero-inner pixel-box">
    <div class="hero-top">
      <span class="version">VER. 1.0.0</span>
      <span class="year">© 2025</span>
    </div>

    <div class="hero-avatar">
      <img src="/pixel-avatar.svg" alt="Pixel art character" class="pixel-sprite" />
    </div>

    <h1 class="hero-title glitch">GUILLERMO JIMÉNEZ</h1>
    <p class="hero-subtitle">DESARROLLADOR WEB</p>

    <div class="hero-prompt blink">▶ PRESS START</div>

    <a href="#about" class="start-btn">[ INICIAR JUEGO ]</a>
  </div>

  <div class="stars" aria-hidden="true"></div>
</section>

<style>
  .hero {
    background: var(--black);
    flex-direction: column;
    position: relative;
    overflow: hidden;
    padding-top: 4rem;
  }

  .stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.6) 0%, transparent 100%),
      radial-gradient(1px 1px at 30% 60%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 50% 10%, rgba(255,255,255,0.7) 0%, transparent 100%),
      radial-gradient(1px 1px at 70% 80%, rgba(255,255,255,0.5) 0%, transparent 100%),
      radial-gradient(1px 1px at 85% 35%, rgba(255,255,255,0.6) 0%, transparent 100%),
      radial-gradient(1px 1px at 20% 90%, rgba(255,255,255,0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 60% 50%, rgba(255,255,255,0.4) 0%, transparent 100%),
      radial-gradient(1px 1px at 90% 70%, rgba(255,255,255,0.5) 0%, transparent 100%),
      radial-gradient(1px 1px at 45% 75%, rgba(255,255,255,0.3) 0%, transparent 100%),
      radial-gradient(1px 1px at 75% 15%, rgba(255,255,255,0.6) 0%, transparent 100%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 600px;
    width: 100%;
    padding: 3rem 2rem;
  }

  .hero-top {
    display: flex;
    justify-content: space-between;
    font-size: 0.45rem;
    color: rgba(0, 255, 65, 0.5);
    margin-bottom: 2rem;
    font-family: var(--font-pixel);
  }

  .hero-avatar {
    margin: 0 auto 2rem;
    animation: float 2s ease-in-out infinite;
  }

  .pixel-sprite {
    image-rendering: pixelated;
    width: 112px;
    height: 160px;
    display: block;
    filter: drop-shadow(0 0 8px rgba(0,255,65,0.4));
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-8px); }
  }

  .hero-title {
    font-size: clamp(1.2rem, 5vw, 2.2rem);
    color: var(--accent);
    letter-spacing: 4px;
    margin-bottom: 1rem;
    font-family: var(--font-pixel);
  }

  .hero-subtitle {
    font-family: var(--font-vt);
    font-size: 1.5rem;
    color: var(--accent3);
    letter-spacing: 6px;
    margin-bottom: 2.5rem;
  }

  .hero-prompt {
    font-size: 0.6rem;
    color: var(--text);
    margin-bottom: 2rem;
    letter-spacing: 2px;
  }

  .start-btn {
    display: inline-block;
    font-family: var(--font-pixel);
    font-size: 0.6rem;
    color: var(--black);
    background: var(--accent);
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    letter-spacing: 2px;
    transition: background 0.1s, color 0.1s;
    box-shadow: 4px 4px 0 rgba(0,255,65,0.3);
  }

  .start-btn:hover {
    background: var(--accent3);
    box-shadow: 4px 4px 0 rgba(255,190,11,0.3);
  }
</style>
