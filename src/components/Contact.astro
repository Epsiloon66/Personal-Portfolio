<style>
  .contact {
    background: var(--bg-section);
    padding-top: 4rem;
  }

  .contact-inner {
    max-width: 600px;
    width: 100%;
    text-align: center;
  }

  .contact-header {
    margin-bottom: 2.5rem;
  }

  .section-tag {
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    color: var(--accent2);
    letter-spacing: 3px;
    margin-bottom: 1.2rem;
  }

  .contact-title {
    font-family: var(--font-pixel);
    font-size: clamp(0.9rem, 3vw, 1.5rem);
    color: var(--accent);
    letter-spacing: 5px;
    margin-bottom: 0.8rem;
    text-shadow: 0 0 16px var(--accent);
  }

  .contact-subtitle {
    font-family: var(--font-vt);
    font-size: 1.3rem;
    color: var(--accent3);
    letter-spacing: 3px;
  }

  .contact-box {
    margin-bottom: 2.5rem;
    border: 2px solid rgba(0,255,65,0.2);
    padding: 1.5rem;
    background: rgba(0,255,65,0.02);
  }

  .contact-box-title {
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    color: var(--accent);
    letter-spacing: 2px;
    margin-bottom: 1rem;
    line-height: 1.8;
  }

  .contact-box-sub {
    font-family: var(--font-vt);
    font-size: 1.15rem;
    color: rgba(255,255,255,0.5);
  }

  .contact-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .contact-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    color: var(--black);
    background: var(--accent);
    padding: 0.75rem 1.25rem;
    text-decoration: none;
    letter-spacing: 2px;
    box-shadow: 0 4px 0 #007a1f, 0 6px 0 rgba(0,0,0,0.4);
    transform: translateY(0);
    transition: transform 0.08s, box-shadow 0.08s;
    position: relative;
  }

  .contact-btn.secondary {
    background: var(--accent3);
    box-shadow: 0 4px 0 #a07800, 0 6px 0 rgba(0,0,0,0.4);
  }

  .contact-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 7px 0 #007a1f, 0 9px 0 rgba(0,0,0,0.3);
  }

  .contact-btn.secondary:hover {
    box-shadow: 0 7px 0 #a07800, 0 9px 0 rgba(0,0,0,0.3);
  }

  .contact-btn:active {
    transform: translateY(4px);
    box-shadow: 0 0px 0 #007a1f;
  }

  .contact-btn.secondary:active {
    box-shadow: 0 0px 0 #a07800;
  }

  .btn-icon {
    font-size: 0.7rem;
  }

  .footer-bar {
    font-family: var(--font-pixel);
    font-size: 0.45rem;
    color: rgba(255,255,255,0.2);
    letter-spacing: 3px;
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    align-items: center;
    border-top: 1px solid rgba(255,255,255,0.05);
    padding-top: 1.5rem;
  }
</style>
